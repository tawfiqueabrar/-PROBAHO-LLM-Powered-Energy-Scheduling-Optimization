# Copy this file to .env for local development. Never commit .env or a real key.
# For Docker/hosting, inject these as runtime environment variables or platform secrets.
OPENAI_API_KEY=your_provider_key_here

# OpenAI-compatible provider configuration. Adjust these for your provider.
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=12

PORT=8000
